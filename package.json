{
  "name": "karnataka-kingdoms-atlas",
  "private": true,
  "license": "SEE LICENSE IN LICENSING.md",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/app.js",
    "start": "node server/app.js",
    "db:migrate": "node server/migrate.js",
    "db:sync-dataset": "node scripts/sync-dataset.mjs",
    "db:sync-research-discovery": "node scripts/sync-research-discovery.mjs",
    "species:export-names": "node scripts/export-species-names.mjs",
    "import:patrika": "node scripts/import-patrika.mjs",
    "import:nakshe-sites": "node scripts/import-nakshe-sites.mjs",
    "import:epigraphia-archive": "node scripts/import-epigraphia-archive.mjs",
    "import:whatisindia": "node scripts/import-whatisindia-inscriptions.mjs",
    "import:bharatrajya": "node scripts/import-bharatrajya.mjs",
    "research:index": "node scripts/build-india-research-index.mjs",
    "import:karnataka-archaeology": "node scripts/import-karnataka-archaeology.mjs",
    "import:bidar-bksp": "node scripts/import-bidar-bksp.mjs",
    "audit:freedom-fighters": "node scripts/audit-freedom-fighters.mjs",
    "extract:martyrs-karnataka": "node scripts/extract-dictionary-martyrs-karnataka.mjs",
    "admin:create": "node server/create-admin.js",
    "backup:live": "sudo ./scripts/backup-live.sh",
    "export:approved": "node scripts/export-approved.mjs",
    "export:static-dataset": "node scripts/export-static-dataset.mjs",
    "publish:static": "./scripts/publish-static.sh",
    "privacy:cleanup": "node scripts/cleanup-private-documents.mjs",
    "canonical:build": "node scripts/build-canonical.mjs",
    "canonical:validate": "node scripts/validate-canonical.mjs",
    "test": "node --test",
    "import:ec": "node scripts/build-canonical.mjs",
    "import:ei": "node scripts/build-canonical.mjs",
    "build": "npm run research:index && npm run canonical:build && node scripts/generate-seo.mjs && node scripts/generate-open-datasets.mjs && vite build && node scripts/prerender-pages.mjs",
    "preview": "vite preview",
    "validate:data": "node scripts/validate-data.mjs",
    "check": "npm run validate:data && node --test && npm run build",
    "build:app": "VITE_STATIC_DATASET=true vite build --outDir dist-app --emptyOutDir",
    "app:sync": "npm run build:app && cap sync",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@vitejs/plugin-react": "latest",
    "express": "^5.2.1",
    "jquery": "^3.7.1",
    "jquery.ime": "^0.2.0-2",
    "leaflet": "latest",
    "mariadb": "^3.5.3",
    "multer": "^2.2.0",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3"
  }
}
