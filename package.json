{
  "name": "karnataka-kingdoms-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/app.js",
    "start": "node server/app.js",
    "db:migrate": "node server/migrate.js",
    "db:sync-dataset": "node scripts/sync-dataset.mjs",
    "import:patrika": "node scripts/import-patrika.mjs",
    "audit:freedom-fighters": "node scripts/audit-freedom-fighters.mjs",
    "admin:create": "node server/create-admin.js",
    "backup:live": "sudo ./scripts/backup-live.sh",
    "export:approved": "node scripts/export-approved.mjs",
    "export:static-dataset": "node scripts/export-static-dataset.mjs",
    "publish:static": "./scripts/publish-static.sh",
    "privacy:cleanup": "node scripts/cleanup-private-documents.mjs",
    "build": "node scripts/generate-seo.mjs && vite build",
    "preview": "vite preview",
    "validate:data": "node scripts/validate-data.mjs",
    "check": "npm run validate:data && node --test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "express": "^5.2.1",
    "leaflet": "latest",
    "mariadb": "^3.5.3",
    "multer": "^2.2.0",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "latest",
    "vite": "latest"
  }
}
