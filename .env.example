NODE_ENV=development
PORT=8787
APP_ORIGIN=http://127.0.0.1:4173
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=karnataka_atlas
DB_USER=karnataka_atlas
DB_PASSWORD=replace-with-a-long-database-password
DB_ROOT_PASSWORD=replace-with-a-separate-long-root-password
DB_POOL_SIZE=10

# Generate with: openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
PRIVATE_UPLOAD_DIR=./var/private-uploads
SESSION_DAYS=14

# Password recovery. Resend is used through its HTTPS API; no mail package is required.
# In local development, an unconfigured reset returns a preview link in the browser.
PASSWORD_RESET_MINUTES=30
RESEND_API_KEY=
MAIL_FROM=Karnataka Historical Atlas <no-reply@example.org>

# Shared public inbox. Origins contain scheme + hostname only, separated by commas.
PUBLIC_MESSAGE_ALLOWED_ORIGINS=https://try-karnata.sanchaya.net,https://sanchaya.github.io
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Browser build. Leave empty for same-origin production; Vite development proxies /api.
VITE_COMMUNITY_API_URL=
# Used by the static edition when contributions live at another public URL.
VITE_LIVE_PORTAL_URL=

# Optional public project-update links. Leave blank to hide a platform.
VITE_SOCIAL_YOUTUBE_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_LINKEDIN_URL=

# Required only when generating an approved public snapshot.
SNAPSHOT_PUBLISHER_ID=

# Berunda, the portal's question-answering guide. Leave the key blank to hide Berunda everywhere.
# The model is called from the server only; the key never reaches the browser.
ANTHROPIC_API_KEY=
BERUNDA_MODEL=claude-haiku-5-5
BERUNDA_DAILY_LIMIT=300
BERUNDA_PER_VISITOR_LIMIT=12
